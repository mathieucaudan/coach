# BEGIN MAINTENANCE COACH GESTIONMARINE
# Supprimer ce bloc uniquement pour retablir le site.
# Ne pas supprimer les regles de securite existantes plus bas.
ErrorDocument 503 /maintenance.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Servir cette page statique sans declencher de nouvelle erreur 503.
    RewriteRule ^maintenance\.html$ - [END]
    # Autoriser les challenges de renouvellement des certificats HTTPS.
    RewriteRule ^\.well-known/acme-challenge/ - [END]
    # Bloquer routes HTML, PHP, assets et actions POST avant le code applicatif.
    RewriteRule ^ - [R=503,END]
</IfModule>
# END MAINTENANCE COACH GESTIONMARINE

DirectoryIndex index.php
Options -Indexes

# Source, schema and config files are never served directly.
<FilesMatch "(\.(sql|md|log|bak|swp|dist|lock|ini|sh)|~|^config\.example\.php|^functions\.php)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.(git|env|idea|vscode)(/|$) - [F,L]
    RewriteRule ^migrations/ - [F,L]
    # Uploaded files are documents only: never run a script from uploads/.
    RewriteRule ^uploads/.*\.(php\d?|phtml|phar|cgi|pl|py)$ - [F,L,NC]
</IfModule>
